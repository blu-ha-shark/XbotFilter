{
  "manifest_version": 3,
  "name": "XbotFilter",
  "version": "1.0.0",
  "description": "自訂關鍵字自動隱藏 X/Twitter 機器人貼文，保持留言區乾淨",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XbotFilter 設定"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
